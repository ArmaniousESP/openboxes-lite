generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled URL for migrations (optional on Neon; same as DATABASE_URL if not set)
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  INVENTORY
}

model Product {
  id                  String          @id @default(cuid())
  productCode         String          @unique @db.VarChar(64)
  name                String          @db.VarChar(255)
  description         String?
  category            String          @default("Donation Stock") @db.VarChar(100)
  unitOfMeasure       String          @default("EA") @db.VarChar(16)
  lotAndExpiryControl Boolean         @default(true)
  active              Boolean         @default(true)
  unitPrice           Decimal?        @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  inventoryItems      InventoryItem[]

  @@index([active])
  @@index([category])
  @@map("products")
}

model InventoryItem {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber      String             @db.VarChar(64)
  expirationDate DateTime           @db.Date
  quantity       Int                @default(0)
  binLocation    String             @db.VarChar(128)
  orgCode        String?            @db.VarChar(32)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  entries        TransactionEntry[]

  @@unique([productId, lotNumber])
  @@index([expirationDate])
  @@index([quantity])
  @@index([binLocation])
  @@map("inventory_items")
}

model Transaction {
  id        String             @id @default(cuid())
  type      TransactionType
  date      DateTime           @default(now())
  notes     String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  entries   TransactionEntry[]

  @@index([date])
  @@index([type])
  @@map("transactions")
}

model TransactionEntry {
  id              String        @id @default(cuid())
  transactionId   String
  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int // positive = in, negative = out

  @@index([inventoryItemId])
  @@map("transaction_entries")
}
