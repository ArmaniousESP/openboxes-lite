# Neon Postgres connection strings
#
# DATABASE_URL  – use the *pooled* connection string for the app
#                 (Neon dashboard → Connection string → "Pooled connection")
# DIRECT_URL    – use the *direct* (non-pooled) string for migrations
#                 If you only have one URL, set both to the same value.
#
# Example pooled host:  ep-xxx-pooler.region.aws.neon.tech
# Example direct host:  ep-xxx.region.aws.neon.tech

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
